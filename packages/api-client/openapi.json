{
  "openapi": "3.1.0",
  "info": {
    "title": "Zhaoniu API",
    "description": "Versioned API for an evidence-led A-share research SaaS.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stocks/search": {
      "get": {
        "tags": [
          "stocks"
        ],
        "summary": "Search Stocks",
        "operationId": "search_stocks_api_v1_stocks_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stocks/{symbol}": {
      "get": {
        "tags": [
          "stocks"
        ],
        "summary": "Get Stock",
        "operationId": "get_stock_api_v1_stocks__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stocks/{symbol}/daily-bars": {
      "get": {
        "tags": [
          "stocks"
        ],
        "summary": "Get Daily Bars",
        "operationId": "get_daily_bars_api_v1_stocks__symbol__daily_bars_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 120,
              "title": "Limit"
            }
          },
          {
            "name": "adjust",
            "in": "query",
            "required": false,
            "schema": {
              "const": "none",
              "type": "string",
              "default": "none",
              "title": "Adjust"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBarListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/watchlists": {
      "get": {
        "tags": [
          "watchlists"
        ],
        "summary": "List Watchlists",
        "operationId": "list_watchlists_api_v1_watchlists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WatchlistResponse"
                  },
                  "type": "array",
                  "title": "Response List Watchlists Api V1 Watchlists Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "watchlists"
        ],
        "summary": "Create Watchlist",
        "operationId": "create_watchlist_api_v1_watchlists_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWatchlistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/watchlists/{watchlist_id}/items": {
      "post": {
        "tags": [
          "watchlists"
        ],
        "summary": "Add Watchlist Item",
        "operationId": "add_watchlist_item_api_v1_watchlists__watchlist_id__items_post",
        "parameters": [
          {
            "name": "watchlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Watchlist Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddWatchlistItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddWatchlistItemRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[0-9A-Z.]{1,16}$",
            "title": "Symbol"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "AddWatchlistItemRequest"
      },
      "CreateWatchlistRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateWatchlistRequest"
      },
      "DailyBarListResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "canonical_symbol": {
            "type": "string",
            "title": "Canonical Symbol"
          },
          "adjust": {
            "type": "string",
            "title": "Adjust"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/DailyBarResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "canonical_symbol",
          "adjust",
          "items",
          "total"
        ],
        "title": "DailyBarListResponse"
      },
      "DailyBarResponse": {
        "properties": {
          "trade_date": {
            "type": "string",
            "format": "date",
            "title": "Trade Date"
          },
          "adjust_type": {
            "type": "string",
            "title": "Adjust Type"
          },
          "open": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "title": "Open"
          },
          "high": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "title": "High"
          },
          "low": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "title": "Low"
          },
          "close": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "title": "Close"
          },
          "pre_close": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pre Close"
          },
          "volume": {
            "type": "integer",
            "title": "Volume"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "title": "Amount"
          },
          "pct_change": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pct Change"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          }
        },
        "type": "object",
        "required": [
          "trade_date",
          "adjust_type",
          "open",
          "high",
          "low",
          "close",
          "pre_close",
          "volume",
          "amount",
          "pct_change",
          "source",
          "collected_at"
        ],
        "title": "DailyBarResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse"
      },
      "StockResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "canonical_symbol": {
            "type": "string",
            "title": "Canonical Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "exchange": {
            "type": "string",
            "title": "Exchange"
          },
          "board": {
            "type": "string",
            "title": "Board"
          },
          "asset_type": {
            "type": "string",
            "title": "Asset Type"
          },
          "list_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "List Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "latest_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Price"
          },
          "change_percent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Percent"
          },
          "latest_trade_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Trade Date"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "collected_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected At"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "canonical_symbol",
          "name",
          "exchange",
          "board",
          "asset_type",
          "list_date",
          "status",
          "industry",
          "latest_price",
          "change_percent",
          "latest_trade_date",
          "source",
          "collected_at"
        ],
        "title": "StockResponse"
      },
      "StockSearchResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/StockResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "StockSearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WatchlistItemResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "added_at"
        ],
        "title": "WatchlistItemResponse"
      },
      "WatchlistResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/WatchlistItemResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "title": "WatchlistResponse"
      }
    }
  }
}

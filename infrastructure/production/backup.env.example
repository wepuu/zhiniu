# Root-owned /etc/zhiniu/backup.env (mode 600).
BACKUP_AGE_RECIPIENT=age1replace_with_the_offline_public_recipient
AGE_IDENTITY_FILE=/etc/zhiniu/backup-age-identity.txt
BACKUP_SSH_KEY=/etc/zhiniu/backup-ssh-key
BACKUP_KNOWN_HOSTS=/etc/zhiniu/backup-known-hosts
BACKUP_REMOTE=zhaoniu-backup@backup.example:/srv/backups/zhiniu

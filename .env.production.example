APP_ENV=production
APP_NAME=zhaoniu
PUBLIC_BASE_URL=https://research.example.com
PUBLIC_HOST=research.example.com
TRUSTED_HOSTS=research.example.com
ALLOWED_ORIGINS=https://research.example.com

DATABASE_URL=postgresql+asyncpg://zhaoniu:replace-me@postgres:5432/zhaoniu
POSTGRES_DB=zhaoniu
POSTGRES_USER=zhaoniu
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

AUTH_COOKIE_SECURE=true
REGISTRATION_INVITE_HMAC_SECRET=replace-with-a-distinct-32-character-secret
ACCESS_ACTIVATION_HMAC_SECRET=replace-with-another-32-character-secret
SCREEN_PARSER_HMAC_SECRET=replace-with-another-32-character-secret
REGISTRATION_MODE=invite_only
BETA_MODE=controlled
BETA_MAX_ACTIVE_USERS=100

ACCESS_ACTIVATION_ENABLED=false
COMMERCIALIZATION_STATUS=review_required
LEGAL_REVIEW_STATUS=review_required
DATA_USE_STATUS=review_required
SUPPORT_CONTACT_URL=
ACCESS_OPERATOR_ID=production-cli

EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
RESEND_FROM_NAME=知牛研究
RESEND_FROM_EMAIL=security@research.example.com
RESEND_SENDING_DOMAIN=research.example.com
RESEND_WEBHOOK_SECRET=

COVERAGE_USAGE_SCOPE=external_beta
COVERAGE_POLICY_VERSION=coverage-policy-v1
COVERAGE_OPERATOR_PINNED_SYMBOLS=600519,300750,300376,000001
COVERAGE_ACCEPTANCE_SYMBOLS=600519,300750,300376,000001
COVERAGE_BACKFILL_BATCH_SIZE=10
COVERAGE_BACKFILL_MAX_CONCURRENCY=2
COVERAGE_PROVIDER_RATE_LIMIT=30
BETA_FEEDBACK_RATE_LIMIT=5
BETA_LEARNING_MIN_GROUP_SIZE=3

LLM_ENABLED=false
LLM_MODEL_CHAIN=
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROVIDER_MAX_CONCURRENCY=2
LLM_PROVIDER_DAILY_CALL_LIMIT=100
SCREEN_PARSER_ENABLED=false
SCREEN_PARSER_MODEL_CHAIN=

OPERATOR_ELEVATION_MINUTES=15
OPERATOR_USER_SEARCH_RATE_LIMIT=30

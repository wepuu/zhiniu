APP_ENV=production
APP_NAME=zhaoniu
PUBLIC_BASE_URL=https://app.zhiniu.cc
# Keep the public hostname first for deployment health checks. The Web
# container uses the internal Compose service alias when proxying /gateway/api/.
TRUSTED_HOSTS=app.zhiniu.cc,api
ALLOWED_ORIGINS=https://app.zhiniu.cc

# CI replaces these tags with immutable sha256 digests for deployment.
API_IMAGE=ghcr.io/wepuu/zhiniu-api@sha256:replace-with-64-hex-characters
WEB_IMAGE=ghcr.io/wepuu/zhiniu-web@sha256:replace-with-64-hex-characters
COMPOSE_PROJECT_NAME=zhaoniu-staging
PRODUCTION_ENV_FILE=/etc/zhiniu/staging.env
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_VOLUME_NAME=zhaoniu_staging_postgres_data
REDIS_VOLUME_NAME=zhaoniu_staging_redis_data

DATABASE_URL=postgresql+asyncpg://zhaoniu:replace-me@postgres:5432/zhaoniu
POSTGRES_DB=zhaoniu
POSTGRES_USER=zhaoniu
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

AUTH_COOKIE_SECURE=true
REGISTRATION_INVITE_HMAC_SECRET=replace-with-a-distinct-32-character-secret
ACCESS_ACTIVATION_HMAC_SECRET=replace-with-another-32-character-secret
SCREEN_PARSER_HMAC_SECRET=replace-with-another-32-character-secret
REGISTRATION_MODE=closed
BETA_MODE=internal
BETA_MAX_ACTIVE_USERS=20

ACCESS_ACTIVATION_ENABLED=false
COMMERCIALIZATION_STATUS=approved
LEGAL_REVIEW_STATUS=approved
DATA_USE_STATUS=approved
SUPPORT_CONTACT_URL=
ACCESS_OPERATOR_ID=production-cli

EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
RESEND_FROM_NAME=知牛研究
RESEND_FROM_EMAIL=info@zhiniu.cc
RESEND_SENDING_DOMAIN=zhiniu.cc
RESEND_WEBHOOK_SECRET=

COVERAGE_USAGE_SCOPE=production
COVERAGE_POLICY_VERSION=coverage-policy-v1
COVERAGE_OPERATOR_PINNED_SYMBOLS=600519,300750,300376,000001
COVERAGE_ACCEPTANCE_SYMBOLS=600519,300750,300376,000001
COVERAGE_BACKFILL_BATCH_SIZE=10
COVERAGE_BACKFILL_MAX_CONCURRENCY=2
COVERAGE_PROVIDER_RATE_LIMIT=30
BETA_FEEDBACK_RATE_LIMIT=5
BETA_LEARNING_MIN_GROUP_SIZE=3

LLM_ENABLED=false
LLM_MODEL_CHAIN=
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROVIDER_MAX_CONCURRENCY=2
LLM_PROVIDER_DAILY_CALL_LIMIT=100
AI_EXPLANATION_ENABLED=false
AI_EXPLANATION_MODEL_CHAIN=deepseek/deepseek-v4-flash
AI_EXPLANATION_MAX_ATTEMPTS=1
AI_EXPLANATION_TIMEOUT_SECONDS=60
AI_EXPLANATION_RUN_DEADLINE_SECONDS=90
AI_EXPLANATION_MAX_OUTPUT_TOKENS=1200
DEEPSEEK_API_KEY=
PROVIDER_CREDENTIAL_ACTIVE_KEY_ID=v1
PROVIDER_CREDENTIAL_KEY_RING=
MANAGED_PROVIDERS_HARD_DISABLED=false
# Optional deployment-level egress proxy; configure only in the runtime secret environment.
PROVIDER_OUTBOUND_HTTP_PROXY_URL=
SCREEN_PARSER_ENABLED=false
SCREEN_PARSER_MODEL_CHAIN=

OPERATOR_ELEVATION_MINUTES=15
OPERATOR_USER_SEARCH_RATE_LIMIT=30

# Automated research stays fail-closed until external acceptance is complete.
AUTOMATION_HARD_DISABLED=true
AUTOMATION_TICK_SECONDS=60
AUTOMATION_MAX_UNIVERSE_SIZE=100
AUTOMATION_MAX_CONCURRENCY=4
AUTOMATION_CATCHUP_WINDOW_MINUTES=360
AUTOMATION_LEASE_MINUTES=30
AUTOMATION_AI_ENABLED=false
AUTOMATION_AI_MAX_CALLS_PER_RUN=10
AUTOMATION_AI_CONCURRENCY=1
WATCHLIST_PREPARATION_ENABLED=false
WATCHLIST_PREPARATION_DAILY_LIMIT=10

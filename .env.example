# APP
APP_ENV=development
APP_NAME=zhaoniu
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# DATABASE
DATABASE_URL=postgresql+asyncpg://zhaoniu:zhaoniu@localhost:5432/zhaoniu
POSTGRES_DB=zhaoniu
POSTGRES_USER=zhaoniu
POSTGRES_PASSWORD=change-me

# REDIS
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AUTH
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=zhaoniu_session
AUTH_COOKIE_SECURE=false

# AI
LLM_ENABLED=false
LLM_MODEL_CHAIN=
LLM_MAX_ATTEMPTS=4
LLM_PER_MODEL_TIMEOUT_SECONDS=75
LLM_RUN_DEADLINE_SECONDS=240
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# DATA_PROVIDER
MARKET_DATA_PROVIDER=akshare
FINANCIAL_DATA_PROVIDER=akshare
TUSHARE_TOKEN=

# STORAGE
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.local/storage

# OBSERVABILITY
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

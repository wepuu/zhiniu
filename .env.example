# APP
APP_ENV=development
APP_NAME=zhaoniu
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_BASE_URL=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:3000

# DATABASE
DATABASE_URL=postgresql+asyncpg://zhaoniu:zhaoniu@localhost:5432/zhaoniu
POSTGRES_DB=zhaoniu
POSTGRES_USER=zhaoniu
POSTGRES_PASSWORD=change-me

# REDIS
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AUTH
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=zhaoniu_session
AUTH_COOKIE_SECURE=false
REGISTRATION_INVITE_HMAC_SECRET=replace-with-at-least-32-random-characters
ACCESS_ACTIVATION_HMAC_SECRET=replace-with-at-least-32-random-characters
ACCESS_ACTIVATION_ENABLED=false
SUPPORT_CONTACT_URL=
ACCESS_OPERATOR_ID=local-cli
COMMERCIALIZATION_STATUS=review_required
REGISTRATION_MODE=invite_only
BETA_MODE=controlled
BETA_MAX_ACTIVE_USERS=500
LEGAL_REVIEW_STATUS=review_required
DATA_USE_STATUS=review_required

# TRANSACTIONAL EMAIL
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_FROM_NAME=知牛研究
RESEND_FROM_EMAIL=
RESEND_SENDING_DOMAIN=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
COVERAGE_USAGE_SCOPE=development_evaluation
COVERAGE_POLICY_VERSION=coverage-policy-v1
COVERAGE_OPERATOR_PINNED_SYMBOLS=600519,300750,300376,000001
COVERAGE_ACCEPTANCE_SYMBOLS=600519,300750,300376,000001
COVERAGE_BACKFILL_BATCH_SIZE=10
COVERAGE_BACKFILL_MAX_CONCURRENCY=2
COVERAGE_PROVIDER_RATE_LIMIT=30
BETA_FEEDBACK_RATE_LIMIT=5
BETA_LEARNING_MIN_GROUP_SIZE=3

# AI
LLM_ENABLED=false
LLM_MODEL_CHAIN=
LLM_MAX_ATTEMPTS=4
LLM_PER_MODEL_TIMEOUT_SECONDS=75
LLM_RUN_DEADLINE_SECONDS=240
LLM_STRUCTURED_OUTPUT_MODE=json_schema
LLM_PROVIDER_MAX_CONCURRENCY=2
LLM_PROVIDER_DAILY_CALL_LIMIT=100
SCREEN_PARSER_ENABLED=false
SCREEN_PARSER_MODEL_CHAIN=
SCREEN_PARSER_MAX_ATTEMPTS=2
SCREEN_PARSER_PER_MODEL_TIMEOUT_SECONDS=30
SCREEN_PARSER_RUN_DEADLINE_SECONDS=75
SCREEN_PARSER_HMAC_SECRET=replace-with-at-least-32-random-characters
SCREEN_PARSER_INPUT_TTL_SECONDS=600
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# INTERNAL OPERATIONS
OPERATOR_ELEVATION_MINUTES=15
OPERATOR_USER_SEARCH_RATE_LIMIT=30

# DATA_PROVIDER
MARKET_DATA_PROVIDER=akshare
FINANCIAL_DATA_PROVIDER=akshare
TUSHARE_TOKEN=

# STORAGE
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.local/storage

# OBSERVABILITY
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
